From e4bc95af90d76cc964d83397c6626f237a789ffc Mon Sep 17 00:00:00 2001
From: jihoon <31067876+yeoj34760@users.noreply.github.com>
Date: Sat, 14 Nov 2026 14:34:01 +0900
Subject: [PATCH] hwcomposer: resize the logical display with single-window SSD

Keep the physical reconnect capability gate. On stock HALs, use the optional Java helper to set WindowManager display size outside composer locks, coalesced after native configure. Mirror LogicalDisplay projection arithmetic when fitting layers and crop the framebuffer target to remove the physical letterbox. Physical input coordinates remain unchanged. Clear the logical override for multi-window mode.

Projection source: AOSP frameworks/base services/core/java/com/android/server/display/LogicalDisplay.java, configureDisplayLocked (Apache-2.0): https://android.googlesource.com/platform/frameworks/base/+/android13-release/services/core/java/com/android/server/display/LogicalDisplay.java
---
 hwcomposer/display-resize.cpp     | 76 +++++++++++++++++++++++++++++--
 hwcomposer/hwcomposer.cpp         | 17 +++++++
 hwcomposer/modes/multi-window.cpp |  2 +
 hwcomposer/wayland-hwc.cpp        | 26 +++++++----
 hwcomposer/wayland-hwc.h          | 10 +++-
 5 files changed, 117 insertions(+), 14 deletions(-)

diff --git a/hwcomposer/display-resize.cpp b/hwcomposer/display-resize.cpp
index 6fc7807..41be63d 100644
--- a/hwcomposer/display-resize.cpp
+++ b/hwcomposer/display-resize.cpp
@@ -42,7 +42,8 @@
  *    handles until SurfaceFlinger has destroyed the old layers. A vendor
  *    image whose composer HAL does both declares
  *    ro.vendor.composer.safe_primary_reconnect=true; without it no hotplug is
- *    ever sent and the display keeps its calibrated size.
+ *    ever sent. Stock images can instead resize WindowManager's logical display
+ *    through the optional waydroid-ssd.jar helper; the physical mode stays fixed.
  *
  * The resize thread holds none of this module's locks while it calls into
  * the adapter or SurfaceFlinger (modes_mutex and resize_mutex are released
@@ -54,6 +55,9 @@
 
 #include <algorithm>
 #include <log/log.h>
+#include <spawn.h>
+#include <sys/wait.h>
+#include <unistd.h>
 
 static constexpr const char *kCapabilityProperty = "ro.vendor.composer.safe_primary_reconnect";
 
@@ -65,6 +69,62 @@ static constexpr int32_t kResizeSettleDefaultMs = 250;
 
 static thread_local bool t_is_resize_thread = false;
 
+/* Mirror LogicalDisplay.configureDisplayLocked's integer letterbox arithmetic.
+ * HWC layers are in physical-display coordinates, even with a forced wm size. */
+hwc_rect_t display_content_frame(struct display *display)
+{
+    std::scoped_lock lock(display->modes_mutex);
+    const int pw = display->phys_width, ph = display->phys_height;
+    const int lw = display->logical_width, lh = display->logical_height;
+    int w = pw, h = ph;
+    if (lw > 0 && lh > 0 && pw > 0 && ph > 0) {
+        if ((int64_t)pw * lh < (int64_t)ph * lw)
+            h = (int64_t)lh * pw / lw;
+        else
+            w = (int64_t)lw * ph / lh;
+    }
+    const int x = (pw - w) / 2, y = (ph - h) / 2;
+    return {x, y, x + w, y + h};
+}
+
+/* Stock HALs cannot reconnect safely. Change WindowManager's logical display
+ * instead, then remove its physical projection's letterbox when presenting.
+ * Run outside all composer locks: WindowManager may wait for SurfaceFlinger. */
+static void resize_logical_display(struct display *display, int width, int height)
+{
+    char aw[16], ah[16];
+    if (width && height) {
+        std::scoped_lock lock(display->modes_mutex);
+        width = std::clamp(width, 200, display->phys_width * 2);
+        height = std::clamp(height, 200, display->phys_height * 2);
+    }
+    snprintf(aw, sizeof(aw), "%d", width);
+    snprintf(ah, sizeof(ah), "%d", height);
+    char *const argv[] = {(char *)"env", (char *)"CLASSPATH=/system/framework/waydroid-ssd.jar",
+        (char *)"/system/bin/app_process", (char *)"/system/bin",
+        (char *)"dev.waydroid.ssd.DisplayResize", aw, ah, nullptr};
+    extern char **environ;
+    pid_t child;
+    int status = -1;
+    int error = posix_spawn(&child, "/system/bin/env", nullptr, nullptr, argv, environ);
+    if (!error) {
+        while (waitpid(child, &status, 0) < 0 && errno == EINTR) {}
+    }
+    if (error || status != 0) {
+        ALOGE("logical display resize %dx%d failed: spawn=%d status=%d", width, height, error, status);
+        return;
+    }
+    {
+        std::scoped_lock lock(display->modes_mutex);
+        display->logical_width = width;
+        display->logical_height = height;
+    }
+    ALOGI("display resize: Android logical display -> %dx%d", width, height);
+    display->modeChanged.store(true, std::memory_order_release);
+    if (display->procs && display->procs->invalidate)
+        display->procs->invalidate(display->procs);
+}
+
 /* Resize thread only. */
 static void
 announce_display_size(struct display *display, int width, int height)
@@ -115,7 +175,10 @@ resize_worker(struct display *display)
         const int width = display->resize_width;
         const int height = display->resize_height;
         lock.unlock();
-        announce_display_size(display, width, height);
+        if (display->resizeUsesReconnect)
+            announce_display_size(display, width, height);
+        else
+            resize_logical_display(display, width, height);
         lock.lock();
     }
 }
@@ -123,7 +186,9 @@ resize_worker(struct display *display)
 void
 display_resize_start(struct display *display)
 {
-    display->resizeFollowsWindow = property_get_bool(kCapabilityProperty, false);
+    display->resizeUsesReconnect = property_get_bool(kCapabilityProperty, false);
+    display->resizeFollowsWindow = display->resizeUsesReconnect ||
+        (display->wantDecorations && access("/system/framework/waydroid-ssd.jar", R_OK) == 0);
     if (!display->resizeFollowsWindow) {
         ALOGI("display resize: the Android display keeps the size it was calibrated with; "
               "%s is not set, so this vendor image's composer HAL is not known to survive a "
@@ -133,7 +198,8 @@ display_resize_start(struct display *display)
     }
     ALOGI("display resize: the Android display follows the window (%s; settled after "
           "persist.waydroid.resize_settle_ms, default %d ms)",
-          kCapabilityProperty, kResizeSettleDefaultMs);
+          display->resizeUsesReconnect ? "physical reconnect" : "logical WindowManager API", kResizeSettleDefaultMs);
+    display->resize_width = display->resize_height = -1;
     display->resize_armed = false;
     display->resize_quit = false;
     display->resize_thread = std::thread(resize_worker, display);
@@ -147,6 +213,8 @@ display_resize_arm(struct display *display, int width, int height)
     const auto settle = std::chrono::milliseconds(std::max(0, property_get_int32(
             "persist.waydroid.resize_settle_ms", kResizeSettleDefaultMs)));
     std::scoped_lock lock(display->resize_mutex);
+    if (display->resize_width == width && display->resize_height == height)
+        return;
     display->resize_width = width;
     display->resize_height = height;
     display->resize_deadline = std::chrono::steady_clock::now() + settle;
diff --git a/hwcomposer/hwcomposer.cpp b/hwcomposer/hwcomposer.cpp
index b91e942..a5b7e83 100644
--- a/hwcomposer/hwcomposer.cpp
+++ b/hwcomposer/hwcomposer.cpp
@@ -526,6 +526,23 @@ int apply_hwc_layer_to_window(waydroid_hwc_composer_device_1 *pdev, hwc_layer_1
         return -1;
     }
 
+    /* The client target contains the physical display's black letterbox. Direct
+     * layers already have SF's clipped displayFrame; crop only the full target.
+     * Copy the descriptor so frame metadata/caches retain their original geometry. */
+    hwc_layer_1 cropped;
+    if (!pdev->display->multiWindows.load(std::memory_order_relaxed) &&
+        hwc_layer->compositionType == HWC_FRAMEBUFFER_TARGET) {
+        const auto frame = display_content_frame(pdev->display);
+        if (frame.left || frame.top) {
+            cropped = *hwc_layer;
+            cropped.displayFrame = frame;
+            cropped.sourceCropf = {(float)frame.left, (float)frame.top,
+                                   (float)frame.right, (float)frame.bottom};
+            hwc_layer->acquireFenceFd = -1; // the copy consumes the fence below
+            hwc_layer = &cropped;
+        }
+    }
+
     auto &window_layer = window->get_next_layer();
 
     const bool task_geometry = window->uses_task_geometry();
diff --git a/hwcomposer/modes/multi-window.cpp b/hwcomposer/modes/multi-window.cpp
index a9984d8..6c97f9e 100644
--- a/hwcomposer/modes/multi-window.cpp
+++ b/hwcomposer/modes/multi-window.cpp
@@ -70,6 +70,8 @@ int multi_window_mode::prepare(hwc_layer_1* hwc_layer, size_t) {
 
 int multi_window_mode::setup_set(waydroid_hwc_composer_device_1* pdev, hwc_display_contents_1_t* contents) {
     layer_infos.setup(pdev, contents->hwLayers, contents->numHwLayers);
+    if (pdev->display->resizeFollowsWindow && !pdev->display->resizeUsesReconnect)
+        display_resize_arm(pdev->display, 0, 0); // clear an earlier single-window override
     if (pdev->display->wantDecorations) {
         /* Freeform windows use the output scale, independently of the last full UI window. */
         pdev->display->scale = pdev->display->output_scale;
diff --git a/hwcomposer/wayland-hwc.cpp b/hwcomposer/wayland-hwc.cpp
index 6550174..0859e77 100644
--- a/hwcomposer/wayland-hwc.cpp
+++ b/hwcomposer/wayland-hwc.cpp
@@ -258,8 +258,8 @@ finished_calibrating(struct display *d)
                 build_display_modes(d);
             d->active_mode = 0;
         }
-        d->follow_width = d->phys_width;
-        d->follow_height = d->phys_height;
+        d->follow_width = d->resizeUsesReconnect ? d->phys_width : -1;
+        d->follow_height = d->resizeUsesReconnect ? d->phys_height : -1;
     }
 }
 
@@ -316,7 +316,8 @@ follow_window_size(struct display *display) {
     if (width != display->follow_width || height != display->follow_height) {
         display->follow_width = width;
         display->follow_height = height;
-        set_touch_size(display, width, height);
+        if (display->resizeUsesReconnect)
+            set_touch_size(display, width, height);
         display_resize_arm(display, width, height);
     }
     request_refresh(display);
@@ -557,9 +558,13 @@ fit_guest_display_to_window(struct display *display)
     if (display->width <= 0 || display->height <= 0 ||
         phys_width <= 0 || phys_height <= 0)
         return;
+    const hwc_rect_t content = display_content_frame(display);
+    phys_width = content.right - content.left;
+    phys_height = content.bottom - content.top;
     /* The guest display is exactly this window at the output scale (the display
      * follows the window, display-resize.cpp): present it 1:1. */
     if (display->output_scale > 0.0 &&
+        content.left == 0 && content.top == 0 &&
         phys_width == (int)floor(display->width * display->output_scale) &&
         phys_height == (int)floor(display->height * display->output_scale)) {
         display->scale = display->output_scale;
@@ -577,8 +582,8 @@ fit_guest_display_to_window(struct display *display)
     display->scale = scale;
     display->present_x = (int)lround((display->width - phys_width / scale) / 2.0);
     display->present_y = (int)lround((display->height - phys_height / scale) / 2.0);
-    if (display->present_x < 0) display->present_x = 0;
-    if (display->present_y < 0) display->present_y = 0;
+    display->present_x -= (int)lround(content.left / scale);
+    display->present_y -= (int)lround(content.top / scale);
 }
 
 /* Whether this window's size may become the Android display's size. The full-UI
@@ -641,17 +646,21 @@ xdg_toplevel_handle_configure(void *data, struct xdg_toplevel *,
         /* Only a window that stands for the whole Android display resizes it:
          * the full UI (task "0") and, without multi-window, the single per-app
          * window. Multi-window cards keep the old path. */
-        if (display->resizeFollowsWindow && window_owns_display_geometry(window)) {
+        if (display->resizeFollowsWindow && window_owns_display_geometry(window) &&
+            (display->resizeUsesReconnect || !display->multiWindows.load(std::memory_order_relaxed))) {
             /* The Android display becomes the window's size (display-resize.cpp).
              * A forced size left by an earlier session would keep the logical
              * display from following, so clear it once. */
             follow_window_size(display);
-            if (!display->clearedForcedSize) {
+            if (display->resizeUsesReconnect && !display->clearedForcedSize) {
                 display->clearedForcedSize = true;
                 resize_guest_display(display, 0, 0);
             }
             return;
         }
+        if (display->resizeFollowsWindow && !display->resizeUsesReconnect &&
+            display->multiWindows.load(std::memory_order_relaxed))
+            display_resize_arm(display, 0, 0);
         do_hotplug(display);
         /* By the first configure the framework is up, whereas window::create
          * can run early enough that `cmd window` finds no WindowManager. */
@@ -761,7 +770,8 @@ shell_surface_configure(void *data, struct wl_shell_surface *, uint32_t, int32_t
 
     if (display->height && display->width) {
         choose_width_height(display, width, height);
-        if (display->resizeFollowsWindow && window_owns_display_geometry(window))
+        if (display->resizeFollowsWindow && window_owns_display_geometry(window) &&
+            (display->resizeUsesReconnect || !display->multiWindows.load(std::memory_order_relaxed)))
             follow_window_size(display);
         else
             do_hotplug(display);
diff --git a/hwcomposer/wayland-hwc.h b/hwcomposer/wayland-hwc.h
index 23e9e16..667dc49 100644
--- a/hwcomposer/wayland-hwc.h
+++ b/hwcomposer/wayland-hwc.h
@@ -583,9 +583,12 @@ struct display {
      * size for a window of W x H is floor(W * output_scale) x floor(H * output_scale),
      * the same size the display was calibrated with for the full output. */
     double output_scale;
-    /* The Android display follows the window (display-resize.cpp): set when the
-     * vendor image declares ro.vendor.composer.safe_primary_reconnect. */
+    /* Physical reconnect on capable HALs; logical WindowManager resize on stock
+     * HALs when the optional Java helper and native decorations are enabled. */
     bool resizeFollowsWindow;
+    bool resizeUsesReconnect = false;
+    /* Logical fallback size, guarded by modes_mutex. The physical mode stays fixed. */
+    int logical_width = 0, logical_height = 0;
     /* persist.waydroid.multi_windows was accepted: every per-app window is a
      * card on a fixed Android display, so a card's size must never become the
      * display's. Off, the one per-app window IS the display (single-window
@@ -642,3 +645,6 @@ struct display *
 create_display(const char* gralloc);
 void
 destroy_display(struct display *display);
+
+/* Physical projection of the forced logical display (Android LogicalDisplay). */
+hwc_rect_t display_content_frame(struct display *display);
-- 
